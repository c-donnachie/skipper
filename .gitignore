node_modules/

# skipper hook scratch (session/marker files written by its own hooks)
.claude/.skipper-*

# skipper memory engine — derived local index (regenerable via `skipper index`)
# ignore the derived index, but KEEP receipts (committed source of truth — ADR-0025)
.skipper/*
!.skipper/receipts/

# skipper-memory MCP — opt-in per-repo, never commit/ship (ADR-0017; regressed on this branch, re-fixed)
.mcp.json
