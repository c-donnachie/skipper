.DS_Store
*.swp
*.swo
.idea/
.vscode/
node_modules/

# skipper hook scratch (session/marker files written by its own hooks)
.claude/.skipper-*

# skipper memory engine — derived local index (regenerable via `skipper index`)
# ignore the derived index, but KEEP receipts (committed source of truth — ADR-0025)
.skipper/*
!.skipper/receipts/

# MCP registration is opt-in per-repo, NOT shipped with the plugin (ADR-0017).
# This repo keeps a local .mcp.json so dev can use the engine, but it must not be
# committed — otherwise the plugin "bundles" it and auto-registers skipper-memory,
# causing a duplicate ("skipped — same command/URL") and a broken relative path
# for end users. Each repo opts in via its own .mcp.json (see engine/README.md).
.mcp.json
